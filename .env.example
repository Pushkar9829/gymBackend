# Copy to .env for local development. On Render, set these in the dashboard.
NODE_ENV=development
PORT=5020
MONGO_URI=mongodb://127.0.0.1:27017/gym_mgmt_dev
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Comma separated frontend origins allowed by CORS
CLIENT_URLS=http://localhost:5173,http://localhost:5195
# Production with app.yourgym.com + api.yourgym.com: COOKIE_DOMAIN=.yourgym.com, COOKIE_SAMESITE=lax
# Production on *.vercel.app + *.onrender.com (no custom domain): COOKIE_SAMESITE=none
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
APP_TIMEZONE=Asia/Kolkata
CRON_SECRET=change-me
# Email (Resend / Brevo SMTP). Leave SMTP_HOST empty in dev: emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=My Gym <no-reply@yourgym.com>
# Cloudinary (photos / documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Razorpay (online payments). Webhook URL: https://api.yourgym.com/api/webhooks/razorpay
# events: payment.captured, payment_link.paid, payment_link.expired
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# SMS / WhatsApp. Providers: log (dev default) | msg91 | twilio  /  log | interakt | twilio
# Then switch the channels on in Settings. Template maps: {"otp":"<id>","renewal_reminder":"<id>",...}
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_TEMPLATES={}
INTERAKT_API_KEY=
INTERAKT_TEMPLATES={}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Error monitoring (optional)
SENTRY_DSN=
# Seed (first run only)
SEED_GYM_NAME=My Fitness Gym
SEED_OWNER_EMAIL=owner@gym.local
SEED_OWNER_PASSWORD=
